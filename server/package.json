{
  "name": "seminar-ie307-server",
  "version": "1.0.0",
  "description": "Snapshot server and update CLI for Android sync seminar IE307",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "update-cli": "./bin/update-cli.js",
    "fcm-sender": "./bin/fcm-sender.js"
  },
  "scripts": {
    "start": "node dist/server.js",
    "update": "node bin/update-cli.js",
    "send-push": "node bin/fcm-sender.js",
    "test": "npm run build && node --test test/*.test.js",
    "build": "tsc",
    "prestart": "npm run build"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "keywords": [
    "seminar",
    "sync",
    "android",
    "fcm"
  ],
  "author": "Thanh Tris & Hoai Tam",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
